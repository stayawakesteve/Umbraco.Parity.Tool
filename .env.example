# Both sites must be running against the same content snapshot.
V13_URL=https://v13.staging.example.com
V17_URL=https://v17.staging.example.com

# Optional basic auth in front of staging
HTTP_USERNAME=
HTTP_PASSWORD=

# Inventory (runs against V17_URL unless INVENTORY_URL is set)
SITEMAP_PATH=/sitemap.xml
DELIVERY_API=1
DELIVERY_API_KEY=
DELIVERY_START_ITEM=
DELIVERY_CULTURES=

# Run controls
WORKERS=4
VISUAL=0
MAX_DIFF_RATIO=0.01
# Regex matched against path or document type alias, e.g. "blogPost|/news/"
URL_FILTER=
# Cap URLs per document type for quick runs. Must match between baseline and compare.
PER_TYPE_LIMIT=0
CONSENT_SELECTOR=

# Log check (Umbraco API user, client id starts with umbraco-back-office-)
UMBRACO_CLIENT_ID=
UMBRACO_CLIENT_SECRET=
LOG_SINCE=
