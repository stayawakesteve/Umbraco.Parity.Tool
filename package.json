{
  "name": "umbraco-parity",
  "private": true,
  "description": "Parity crawl: compares every published page on an upgraded Umbraco site (v17) against the original (v13).",
  "scripts": {
    "inventory": "tsx scripts/inventory.ts",
    "baseline": "playwright test --project=baseline --update-snapshots=all",
    "compare": "playwright test --project=compare",
    "logs": "tsx scripts/check-logs.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
